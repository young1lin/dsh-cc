{
  "name": "@young1lin/dsh-cc",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Claude Code inside the DeepSeek Harness web GUI: right-edge dock entry, session overlay, and an env-configurable Claude Agent SDK bridge",
  "author": "young1lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young1lin/dsh-cc.git"
  },
  "homepage": "https://github.com/young1lin/dsh-cc#readme",
  "bugs": "https://github.com/young1lin/dsh-cc/issues",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" --input-type=module || true",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "smoke": "node scripts/client-smoke.mjs",
    "secret-contract": "node --experimental-transform-types scripts/secret-contract.mjs",
    "prepublishOnly": "pnpm run build && pnpm run smoke && pnpm run secret-contract && pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "claude-code",
    "claude-agent-sdk",
    "anthropic",
    "web-ui"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
