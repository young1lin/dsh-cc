# 复制本文件为 .env（已 gitignore）并填入真实值；仓库里只允许存在本模板。
# GIT_BASH 可选：bash.exe 完整路径；不填则自动探测 Git for Windows 常见安装位置。
#GIT_BASH=C:/Program Files/Git/bin/bash.exe
BASE_URL=https://open.bigmodel.cn/api/anthropic
AUTH_TOKEN=<你的中转 token>
API_TIMEOUT_MS=3000000
MODEL=glm-5.3[1m]
SMALL_FAST_MODEL=glm-5.3-flash
SONNET_MODEL=glm-5.3[1m]
OPUS_MODEL=glm-5.3[1m]
HAIKU_MODEL=glm-5.3-flash
